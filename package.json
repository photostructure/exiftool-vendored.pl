{
  "name": "exiftool-vendored.pl",
  "version": "13.59.0",
  "description": "Vendored perl ExifTool for Node.js",
  "main": "./index.js",
  "homepage": "https://github.com/photostructure/exiftool-vendored.pl#readme",
  "bugs": {
    "url": "https://github.com/photostructure/exiftool-vendored/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photostructure/exiftool-vendored.pl.git"
  },
  "bin": {
    "exiftool": "./bin/exiftool"
  },
  "os": [
    "!win32"
  ],
  "files": [
    "bin",
    "index.js"
  ],
  "keywords": [
    "ExifTool",
    "EXIF"
  ],
  "author": "Matthew McEachen <exiftool-vendored-pl@photostructure.com>",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "error"
    }
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "test": "mocha",
    "fmt": "prettier --write .",
    "lint": "prettier --check .",
    "check:npm-version": "node scripts/check-npm-version.js",
    "preupdate": "npm run check:npm-version",
    "update": "run-s update:*",
    "update:deps": "npm run check:npm-version && npm-check-updates --upgrade --install always",
    "update:exiftool": "bash -c ./update-exiftool.sh",
    "check-version": "node check-version.js",
    "install:pinact": "go install github.com/suzuki-shunsuke/pinact/v4/cmd/pinact@v4.1.0",
    "update:actions": "go run github.com/suzuki-shunsuke/pinact/v4/cmd/pinact@v4.1.0 run -u",
    "preflight": "npm run check:npm-version && run-s update fmt check-version test"
  },
  "devDependencies": {
    "mocha": "^11.7.6",
    "npm-run-all2": "9.0.2",
    "npm-check-updates": "22.2.9",
    "prettier": "3.9.6",
    "xml2js": "^0.6.2"
  }
}
